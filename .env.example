# =============================================================================
# geek-door (.env.example)
# Copy to .env on your local machine or Ubuntu VPS:
#   cp .env.example .env && chmod 600 .env
# =============================================================================

# --- Network & Port Binding ---
# Default binding is 127.0.0.1 to prevent Docker UFW firewall bypass on public VPS.
# Change to 0.0.0.0 ONLY for trusted private local LAN development without a reverse proxy.
GEEK_DOOR_BIND_IP=127.0.0.1
GEEK_DOOR_PORT=5050

# --- Optional REST API Key (Recommended on public Ubuntu VPS) ---
# When set, all /api/* requests (except /api/health) require either:
#   Authorization: Bearer <GEEK_DOOR_API_KEY>
#   X-API-Key: <GEEK_DOOR_API_KEY>
# Leave empty for open local LAN access.
GEEK_DOOR_API_KEY=

# --- GeekSmart & Tuya Account Bootstrap (Auto-creates .session_cache.json) ---
GEEKSMART_EMAIL=your-email@example.com
GEEKSMART_PASSWORD=your-password
GEEKSMART_CLIENT_ID=
GEEKSMART_TOKEN=

# --- Hop 2 Tuya OEM Cloud Context (a1.tuyaus.com) ---
TUYA_UID=
TUYA_HOME_ID=
TUYA_COUNTRY_CODE=1
TUYA_SID=
TUYA_ECODE=
